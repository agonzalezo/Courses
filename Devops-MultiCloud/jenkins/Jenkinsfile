pipeline {
    agent any

    triggers {
        githubPush()
        pollSCM('H */5 * * *')
    }

    environment {
        VAR_NAME = 'Tecylab DevOps'
    }

    stages {
        stage('Hello') {
            steps {
                echo "Hello ${VAR_NAME}"
            }
        }

        stage('Deploy PDN') {
            when {
                branch 'refs/remotes/origin/main'
            }
            steps {
                echo 'Deploying PDN...'
                sh 'echo "Deploying PDN..."'
            }
        }

        stage('Environment') {
            steps {
                sh 'whoami'
                sh 'hostname'
                sh 'date'
                sh 'uptime'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
