pipeline {
    agent any

    triggers {
        githubPush()
        pollSCM('H */5 * * *')
    }

    environment {
        VAR_NAME = 'Tecylab DevOps'
    }

    stages {
        stage('Hello') {
            steps {
                echo "Hello ${VAR_NAME}"
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Do you want to proceed?', ok: 'Yes'
                }
            }
        }

        stage('Debug Branch') {
            steps {
                echo "GIT_BRANCH=${env.GIT_BRANCH}"
                echo "BRANCH_NAME=${env.BRANCH_NAME}"
                sh 'git branch --show-current || true'
                sh 'git rev-parse --abbrev-ref HEAD || true'
            }
        }

        stage('Deploy PDN') {
            when {
                expression { env.GIT_BRANCH ==~ /.*main/ }
            }
            steps {
                echo 'Deploying PDN...'
                sh 'echo "Deploying PDN..."'
            }
        }

        stage('Environment') {
            steps {
                sh 'whoami'
                sh 'hostname'
                sh 'date'
                sh 'uptime'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
