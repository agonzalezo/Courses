pipeline {
    agent any

    triggers {
        githubPush()
        pollSCM('H */5 * * *')
    }

    environment {
        VAR_NAME = 'Tecylab DevOps'
    }

    stages {
        stage('Hello') {
            steps {
                echo "Hello ${VAR_NAME}"
            }
        }

        stage('Deploy PDN') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Deploy to Production?', ok: 'Approve'
                }
                echo 'Deploying PDN...'
                sh 'echo "Deploying PDN..."'
            }
        }

        stage('Environment') {
            steps {
                sh 'whoami'
                sh 'hostname'
                sh 'date'
                sh 'uptime'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
